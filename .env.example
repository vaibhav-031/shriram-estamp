# Copy to .env and fill in. Never commit .env.
# Use a DB user that can ONLY touch the shriram_estamp schema (see README).
ESTAMP_DB_URL=postgresql://estamp_user:CHANGE_ME@db-host:5432/zoop_db

# In-house OCR API. Set ESTAMP_OCR_URL to the PRODUCTION endpoint at go-live – keeps the
# endpoint out of git; if unset, the dev URL in config.yaml (zoop_api.ocr.url) is used.
ESTAMP_OCR_URL=
ZOOP_OCR_API_KEY=
ZOOP_OCR_ORG_ACC=
ZOOP_SPLIT_API_KEY=

# Alerts (at least one recommended)
ESTAMP_SLACK_WEBHOOK=
ESTAMP_SMTP_USER=
ESTAMP_SMTP_PASSWORD=
# e.g. a healthchecks.io ping URL – alerts you if the Mac/service stops running
ESTAMP_HEARTBEAT_URL=
